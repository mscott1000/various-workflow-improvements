// ==UserScript==
// @name         Codex - Compact Wider Interface + Safe Blackouts
// @namespace    mason-codex-cleanup
// @version      6.0
// @description  Widens Codex, reduces excess spacing, blacks out selected text, and visually masks only the top-left branding area.
// @match        https://chatgpt.com/codex*
// @match        https://chatgpt.com/codex/cloud*
// @match        https://chatgpt.com/*/codex*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    'use strict';


    // =========================================================
    // SETTINGS
    // =========================================================

    /*
     * CODEX WIDTH
     *
     * 1.20 = 20% wider
     * 1.40 = 40% wider
     * 1.70 = 70% wider
     */
    const WIDTH_MULTIPLIER = 1.70;


    /*
     * MOVE CODEX UP
     *
     * Reduces the blank area above the main Codex composer.
     */
    const TOP_SHIFT_PX = 90;


    /*
     * Maximum percentage of browser width that the widened
     * Codex workspace may occupy.
     */
    const MAX_VIEWPORT_WIDTH = 0.92;


    /*
     * TOP-LEFT VISUAL MASK
     *
     * This blacks out ONLY the branding area in the upper-left.
     *
     * It does NOT hide the header.
     * It does NOT remove any React elements.
     * It does NOT interfere with clicks.
     *
     * Adjust these two numbers if the branding area changes.
     */
    const TOP_LEFT_MASK_WIDTH = 240;
    const TOP_LEFT_MASK_HEIGHT = 62;


    /*
     * TEXT TO BLACK OUT
     */
    const TARGET_TEXT =
        'What should we code next?';


    const BLACKOUT_CLASS =
        'tm-codex-blackout-text';


    const BLACKOUT_STYLE_ID =
        'tm-codex-blackout-style';


    const TOP_LEFT_MASK_ID =
        'tm-codex-top-left-mask';



    // =========================================================
    // INSTALL BLACKOUT CSS
    // =========================================================

    function installBlackoutCSS() {

        if (
            document.getElementById(
                BLACKOUT_STYLE_ID
            )
        ) {
            return;
        }


        const style =
            document.createElement('style');


        style.id =
            BLACKOUT_STYLE_ID;


        style.textContent = `

            .${BLACKOUT_CLASS} {
                color: transparent !important;
                background: #000 !important;
                text-shadow: none !important;
                border-radius: 0 !important;

                user-select: none !important;
                -webkit-user-select: none !important;
            }

            .${BLACKOUT_CLASS} * {
                color: transparent !important;
                text-shadow: none !important;
            }

        `;


        document.head.appendChild(
            style
        );
    }



    // =========================================================
    // TOP-LEFT BRANDING MASK
    //
    // IMPORTANT:
    //
    // This is ONLY a visual rectangle.
    //
    // pointer-events: none
    //
    // means all underlying controls remain completely clickable.
    //
    // Nothing in the actual ChatGPT/Codex header DOM is removed.
    // =========================================================

    function installTopLeftMask() {

        let mask =
            document.getElementById(
                TOP_LEFT_MASK_ID
            );


        if (!mask) {

            mask =
                document.createElement(
                    'div'
                );


            mask.id =
                TOP_LEFT_MASK_ID;


            document.body.appendChild(
                mask
            );
        }


        mask.style.setProperty(
            'position',
            'fixed',
            'important'
        );


        mask.style.setProperty(
            'top',
            '0',
            'important'
        );


        mask.style.setProperty(
            'left',
            '0',
            'important'
        );


        mask.style.setProperty(
            'width',
            `${TOP_LEFT_MASK_WIDTH}px`,
            'important'
        );


        mask.style.setProperty(
            'height',
            `${TOP_LEFT_MASK_HEIGHT}px`,
            'important'
        );


        mask.style.setProperty(
            'background',
            '#000',
            'important'
        );


        /*
         * Extremely high z-index ensures it visually covers
         * the branding.
         */
        mask.style.setProperty(
            'z-index',
            '2147483647',
            'important'
        );


        /*
         * CRITICAL:
         *
         * The mask cannot capture mouse clicks.
         *
         * Anything underneath remains functional.
         */
        mask.style.setProperty(
            'pointer-events',
            'none',
            'important'
        );


        mask.style.setProperty(
            'user-select',
            'none',
            'important'
        );
    }



    // =========================================================
    // BLACK OUT AN ELEMENT
    // =========================================================

    function blackoutElement(el) {

        if (!el) {
            return;
        }


        if (
            el.classList?.contains(
                BLACKOUT_CLASS
            )
        ) {
            return;
        }


        el.classList.add(
            BLACKOUT_CLASS
        );


        el.style.setProperty(
            'color',
            'transparent',
            'important'
        );


        el.style.setProperty(
            'background',
            '#000',
            'important'
        );


        el.style.setProperty(
            'text-shadow',
            'none',
            'important'
        );
    }



    // =========================================================
    // BLACK OUT:
    //
    // "What should we code next?"
    // =========================================================

    function blackoutTargetText(
        root = document.body
    ) {

        if (!root) {
            return;
        }


        const walker =
            document.createTreeWalker(
                root,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode(node) {

                        if (
                            !node.nodeValue ||
                            !node.nodeValue.includes(
                                TARGET_TEXT
                            )
                        ) {
                            return NodeFilter.FILTER_REJECT;
                        }


                        const parent =
                            node.parentElement;


                        if (!parent) {
                            return NodeFilter.FILTER_REJECT;
                        }


                        if (
                            parent.closest(
                                `.${BLACKOUT_CLASS}`
                            )
                        ) {
                            return NodeFilter.FILTER_REJECT;
                        }


                        const tag =
                            parent.tagName
                                ?.toLowerCase();


                        if (
                            [
                                'script',
                                'style',
                                'noscript'
                            ].includes(tag)
                        ) {
                            return NodeFilter.FILTER_REJECT;
                        }


                        return NodeFilter.FILTER_ACCEPT;
                    }
                }
            );


        const matches = [];


        while (
            walker.nextNode()
        ) {

            matches.push(
                walker.currentNode
            );
        }



        for (
            const textNode of matches
        ) {

            const parent =
                textNode.parentElement;



            // -------------------------------------------------
            // Entire element is the target phrase.
            // -------------------------------------------------

            if (
                parent &&
                parent.textContent.trim() ===
                    TARGET_TEXT
            ) {

                blackoutElement(
                    parent
                );

                continue;
            }



            // -------------------------------------------------
            // Target phrase appears inside longer text.
            // -------------------------------------------------

            const parts =
                textNode.nodeValue.split(
                    TARGET_TEXT
                );


            const fragment =
                document.createDocumentFragment();


            parts.forEach(
                (part, index) => {

                    if (part) {

                        fragment.appendChild(
                            document.createTextNode(
                                part
                            )
                        );
                    }


                    if (
                        index <
                        parts.length - 1
                    ) {

                        const span =
                            document.createElement(
                                'span'
                            );


                        span.className =
                            BLACKOUT_CLASS;


                        span.textContent =
                            TARGET_TEXT;


                        fragment.appendChild(
                            span
                        );
                    }
                }
            );


            textNode.replaceWith(
                fragment
            );
        }



        // -----------------------------------------------------
        // INPUT / TEXTAREA PLACEHOLDER FALLBACK
        // -----------------------------------------------------

        document
            .querySelectorAll(
                'input, textarea'
            )
            .forEach(field => {

                if (
                    field.placeholder ===
                    TARGET_TEXT
                ) {

                    field.placeholder = '';


                    field.style.setProperty(
                        'background',
                        '#000',
                        'important'
                    );
                }
            });
    }



    // =========================================================
    // FIND CODEX COMPOSER
    // =========================================================

    function findComposer() {

        const candidates =
            document.querySelectorAll(
                'textarea, input, [contenteditable="true"], [role="textbox"]'
            );


        for (const el of candidates) {

            const text = [

                el.getAttribute(
                    'placeholder'
                ),

                el.getAttribute(
                    'aria-label'
                ),

                el.textContent

            ]
                .filter(Boolean)
                .join(' ')
                .toLowerCase();


            if (
                text.includes(
                    'describe a task'
                ) ||

                text.includes(
                    'ask a question'
                ) ||

                text.includes(
                    '/plan'
                )
            ) {

                return el;
            }
        }


        return null;
    }



    // =========================================================
    // FIND MAIN CODEX WORKSPACE
    //
    // Previously identified through our diagnostic as:
    //
    // div.z-0.mx-auto
    // =========================================================

    function findWorkspace() {

        const composer =
            findComposer();


        if (!composer) {
            return null;
        }


        let el =
            composer;


        while (
            el &&
            el !== document.body &&
            el !== document.documentElement
        ) {

            if (
                el.classList &&
                el.classList.contains(
                    'z-0'
                ) &&
                el.classList.contains(
                    'mx-auto'
                )
            ) {

                return el;
            }


            el =
                el.parentElement;
        }


        return null;
    }



    // =========================================================
    // WIDEN + MOVE CODEX WORKSPACE
    // =========================================================

    function adjustWorkspace() {

        const workspace =
            findWorkspace();


        if (!workspace) {
            return;
        }



        // -----------------------------------------------------
        // Remember original width exactly once.
        // -----------------------------------------------------

        if (
            !workspace.dataset
                .codexOriginalWidth
        ) {

            const originalWidth =
                workspace
                    .getBoundingClientRect()
                    .width;


            workspace.dataset
                .codexOriginalWidth =
                String(
                    originalWidth
                );
        }



        const originalWidth =
            parseFloat(
                workspace.dataset
                    .codexOriginalWidth
            );


        if (
            !originalWidth ||
            isNaN(originalWidth)
        ) {
            return;
        }



        // -----------------------------------------------------
        // Calculate widened size.
        // -----------------------------------------------------

        const requestedWidth =
            originalWidth *
            WIDTH_MULTIPLIER;


        const maximumWidth =
            window.innerWidth *
            MAX_VIEWPORT_WIDTH;


        const finalWidth =
            Math.min(
                requestedWidth,
                maximumWidth
            );



        // -----------------------------------------------------
        // Apply width.
        // -----------------------------------------------------

        workspace.style.setProperty(
            'width',
            `${finalWidth}px`,
            'important'
        );


        workspace.style.setProperty(
            'max-width',
            `${finalWidth}px`,
            'important'
        );


        workspace.style.setProperty(
            'min-width',
            '0',
            'important'
        );


        workspace.style.setProperty(
            'margin-left',
            'auto',
            'important'
        );


        workspace.style.setProperty(
            'margin-right',
            'auto',
            'important'
        );



        // -----------------------------------------------------
        // REDUCE BLANK AREA ABOVE CODEX
        // -----------------------------------------------------

        workspace.style.setProperty(
            'transform',
            `translateY(-${TOP_SHIFT_PX}px)`,
            'important'
        );



        // -----------------------------------------------------
        // Remove original-width restrictions from inner
        // Codex elements.
        // -----------------------------------------------------

        const descendants =
            workspace.querySelectorAll(
                'div, section, form'
            );


        descendants.forEach(el => {

            const rect =
                el.getBoundingClientRect();


            if (
                rect.width >=
                    originalWidth - 5 &&

                rect.width <=
                    originalWidth + 5
            ) {

                el.style.setProperty(
                    'max-width',
                    '100%',
                    'important'
                );


                el.style.setProperty(
                    'width',
                    '100%',
                    'important'
                );
            }
        });
    }



    // =========================================================
    // APPLY EVERYTHING
    // =========================================================

    function applyTweaks() {

        /*
         * CSS required for text blackout.
         */
        installBlackoutCSS();


        /*
         * Visually cover ONLY the upper-left branding area.
         *
         * No header elements are removed.
         */
        installTopLeftMask();


        /*
         * Widen and reposition Codex.
         */
        adjustWorkspace();


        /*
         * Black out:
         *
         * "What should we code next?"
         */
        blackoutTargetText();
    }



    // =========================================================
    // INITIAL LOAD
    //
    // Codex renders in stages.
    // =========================================================

    setTimeout(
        applyTweaks,
        100
    );


    setTimeout(
        applyTweaks,
        500
    );


    setTimeout(
        applyTweaks,
        1000
    );


    setTimeout(
        applyTweaks,
        2000
    );



    // =========================================================
    // WATCH FOR CODEX / REACT REDRAWS
    // =========================================================

    let updateTimer;


    const observer =
        new MutationObserver(() => {

            clearTimeout(
                updateTimer
            );


            updateTimer =
                setTimeout(
                    applyTweaks,
                    120
                );
        });



    observer.observe(
        document.body,
        {
            childList: true,
            subtree: true,
            characterData: true
        }
    );



    // =========================================================
    // BROWSER RESIZE
    // =========================================================

    window.addEventListener(
        'resize',
        () => {

            clearTimeout(
                updateTimer
            );


            updateTimer =
                setTimeout(
                    applyTweaks,
                    150
                );
        }
    );

})();

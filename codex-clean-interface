// ==UserScript==
// @name         Codex - Compact Wider Interface + Blackout
// @namespace    mason-codex-cleanup
// @version      5.2
// @description  Widens Codex, reduces excess top spacing, hides the header only on the Codex home screen, and blacks out selected Codex text.
// @match        https://chatgpt.com/*
// @match        https://*.chatgpt.com/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    'use strict';


    // =========================================================
    // SETTINGS
    // =========================================================

    /*
     * CODEX WIDTH
     *
     * 1.20 = 20% wider
     * 1.40 = 40% wider
     * 1.70 = 70% wider
     */
    const WIDTH_MULTIPLIER = 1.70;


    /*
     * MOVE CODEX UP
     *
     * Reduces the blank area above the home-page composer.
     */
    const TOP_SHIFT_PX = 90;


    /*
     * Maximum percentage of the browser window that the
     * widened Codex workspace may occupy.
     */
    const MAX_VIEWPORT_WIDTH = 0.92;


    /*
     * TEXT BLACKOUT
     */
    const TARGET_TEXT = 'What should we code next?';

    const BLACKOUT_CLASS =
        'tm-codex-blackout-text';

    const BLACKOUT_STYLE_ID =
        'tm-codex-blackout-style';



    // =========================================================
    // BLACKOUT CSS
    // =========================================================

    function installBlackoutCSS() {

        if (
            document.getElementById(
                BLACKOUT_STYLE_ID
            )
        ) {
            return;
        }


        const style =
            document.createElement('style');


        style.id =
            BLACKOUT_STYLE_ID;


        style.textContent = `
            .${BLACKOUT_CLASS} {
                color: transparent !important;
                background: #000 !important;
                text-shadow: none !important;
                border-radius: 0 !important;

                user-select: none !important;
                -webkit-user-select: none !important;
            }

            .${BLACKOUT_CLASS} * {
                color: transparent !important;
                text-shadow: none !important;
            }
        `;


        document.head.appendChild(
            style
        );
    }



    // =========================================================
    // BLACK OUT ONE ELEMENT
    // =========================================================

    function blackoutElement(el) {

        if (!el) {
            return;
        }


        if (
            el.classList?.contains(
                BLACKOUT_CLASS
            )
        ) {
            return;
        }


        el.classList.add(
            BLACKOUT_CLASS
        );


        /*
         * Preserve the element's normal dimensions,
         * but show a solid black block instead of text.
         */

        el.style.setProperty(
            'color',
            'transparent',
            'important'
        );


        el.style.setProperty(
            'background',
            '#000',
            'important'
        );


        el.style.setProperty(
            'text-shadow',
            'none',
            'important'
        );
    }



    // =========================================================
    // FIND + BLACK OUT:
    //
    // "What should we code next?"
    // =========================================================

    function blackoutTargetText(
        root = document.body
    ) {

        if (!root) {
            return;
        }


        const walker =
            document.createTreeWalker(
                root,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode(node) {

                        if (
                            !node.nodeValue ||
                            !node.nodeValue.includes(
                                TARGET_TEXT
                            )
                        ) {
                            return NodeFilter.FILTER_REJECT;
                        }


                        const parent =
                            node.parentElement;


                        if (!parent) {
                            return NodeFilter.FILTER_REJECT;
                        }


                        const tag =
                            parent.tagName
                                ?.toLowerCase();


                        if (
                            [
                                'script',
                                'style',
                                'noscript'
                            ].includes(tag)
                        ) {
                            return NodeFilter.FILTER_REJECT;
                        }


                        return NodeFilter.FILTER_ACCEPT;
                    }
                }
            );


        const matches = [];


        while (
            walker.nextNode()
        ) {

            matches.push(
                walker.currentNode
            );
        }



        for (
            const textNode of matches
        ) {

            const parent =
                textNode.parentElement;


            /*
             * If the entire element is just:
             *
             * "What should we code next?"
             *
             * black out the whole element.
             */
            if (
                parent &&
                parent.textContent.trim() ===
                    TARGET_TEXT
            ) {

                blackoutElement(
                    parent
                );

                continue;
            }



            /*
             * If the target phrase is embedded inside
             * some longer text, black out only the target.
             */

            const parts =
                textNode.nodeValue.split(
                    TARGET_TEXT
                );


            const fragment =
                document.createDocumentFragment();


            parts.forEach(
                (part, index) => {

                    if (part) {

                        fragment.appendChild(
                            document.createTextNode(
                                part
                            )
                        );
                    }


                    if (
                        index <
                        parts.length - 1
                    ) {

                        const span =
                            document.createElement(
                                'span'
                            );


                        span.className =
                            BLACKOUT_CLASS;


                        span.textContent =
                            TARGET_TEXT;


                        fragment.appendChild(
                            span
                        );
                    }
                }
            );


            textNode.replaceWith(
                fragment
            );
        }



        // -----------------------------------------------------
        // PLACEHOLDER FALLBACK
        //
        // If Codex uses the phrase as a textarea/input
        // placeholder instead of ordinary text.
        // -----------------------------------------------------

        document
            .querySelectorAll(
                'input, textarea'
            )
            .forEach(field => {

                if (
                    field.placeholder ===
                    TARGET_TEXT
                ) {

                    field.placeholder = '';

                    field.style.setProperty(
                        'background',
                        '#000',
                        'important'
                    );
                }
            });
    }



    // =========================================================
    // FIND THE CODEX TEXT ENTRY FIELD
    // =========================================================

    function findComposer() {

        const candidates =
            document.querySelectorAll(
                'textarea, input, [contenteditable="true"], [role="textbox"]'
            );


        for (const el of candidates) {

            const text = [
                el.getAttribute(
                    'placeholder'
                ),

                el.getAttribute(
                    'aria-label'
                ),

                el.textContent
            ]
                .filter(Boolean)
                .join(' ')
                .toLowerCase();


            if (
                text.includes(
                    'describe a task'
                ) ||

                text.includes(
                    'ask a question'
                ) ||

                text.includes(
                    '/plan'
                )
            ) {

                return el;
            }
        }


        return null;
    }



    // =========================================================
    // FIND THE MAIN CODEX WORKSPACE
    //
    // Diagnostic identified the home wrapper as:
    //
    // div.z-0.mx-auto
    // =========================================================

    function findWorkspace() {

        const composer =
            findComposer();


        if (!composer) {
            return null;
        }


        let el =
            composer;


        while (
            el &&
            el !== document.body &&
            el !== document.documentElement
        ) {

            if (
                el.classList &&
                el.classList.contains(
                    'z-0'
                ) &&
                el.classList.contains(
                    'mx-auto'
                )
            ) {

                return el;
            }


            el =
                el.parentElement;
        }


        return null;
    }



    // =========================================================
    // WIDEN + MOVE THE CODEX HOME WORKSPACE
    // =========================================================

    function adjustWorkspace() {

        const workspace =
            findWorkspace();


        if (!workspace) {
            return;
        }



        // -----------------------------------------------------
        // Remember original width once.
        // -----------------------------------------------------

        if (
            !workspace.dataset
                .codexOriginalWidth
        ) {

            const originalWidth =
                workspace
                    .getBoundingClientRect()
                    .width;


            workspace.dataset
                .codexOriginalWidth =
                String(
                    originalWidth
                );
        }



        const originalWidth =
            parseFloat(
                workspace.dataset
                    .codexOriginalWidth
            );


        if (
            !originalWidth ||
            isNaN(originalWidth)
        ) {
            return;
        }



        // -----------------------------------------------------
        // Calculate widened size.
        // -----------------------------------------------------

        const requestedWidth =
            originalWidth *
            WIDTH_MULTIPLIER;


        const maximumWidth =
            window.innerWidth *
            MAX_VIEWPORT_WIDTH;


        const finalWidth =
            Math.min(
                requestedWidth,
                maximumWidth
            );



        // -----------------------------------------------------
        // Apply width.
        // -----------------------------------------------------

        workspace.style.setProperty(
            'width',
            `${finalWidth}px`,
            'important'
        );


        workspace.style.setProperty(
            'max-width',
            `${finalWidth}px`,
            'important'
        );


        workspace.style.setProperty(
            'min-width',
            '0',
            'important'
        );


        workspace.style.setProperty(
            'margin-left',
            'auto',
            'important'
        );


        workspace.style.setProperty(
            'margin-right',
            'auto',
            'important'
        );



        // -----------------------------------------------------
        // Move the home workspace upward.
        // -----------------------------------------------------

        workspace.style.setProperty(
            'transform',
            `translateY(-${TOP_SHIFT_PX}px)`,
            'important'
        );



        // -----------------------------------------------------
        // Remove old inner 768px-style width limits.
        // -----------------------------------------------------

        const descendants =
            workspace.querySelectorAll(
                'div, section, form'
            );


        descendants.forEach(el => {

            const rect =
                el.getBoundingClientRect();


            if (
                rect.width >=
                    originalWidth - 5 &&

                rect.width <=
                    originalWidth + 5
            ) {

                el.style.setProperty(
                    'max-width',
                    '100%',
                    'important'
                );


                el.style.setProperty(
                    'width',
                    '100%',
                    'important'
                );
            }
        });
    }



    // =========================================================
    // DETERMINE WHETHER THIS IS THE CODEX HOME SCREEN
    //
    // Header hiding happens ONLY if we're confident this is
    // the task-list/home page.
    //
    // Active coding tasks fail safe: header remains visible.
    // =========================================================

    function isCodexHomeScreen() {

        const bodyText =
            (
                document.body
                    ?.innerText || ''
            )
                .toLowerCase();



        // -----------------------------------------------------
        // HOME COMPOSER
        // -----------------------------------------------------

        const candidates =
            document.querySelectorAll(
                'textarea, input, [contenteditable="true"], [role="textbox"]'
            );


        let hasDescribeTaskComposer =
            false;


        for (const el of candidates) {

            const text = [
                el.getAttribute(
                    'placeholder'
                ),

                el.getAttribute(
                    'aria-label'
                ),

                el.textContent
            ]
                .filter(Boolean)
                .join(' ')
                .toLowerCase();


            if (
                text.includes(
                    'describe a task'
                )
            ) {

                hasDescribeTaskComposer =
                    true;

                break;
            }
        }



        // -----------------------------------------------------
        // HOME NAVIGATION
        // -----------------------------------------------------

        const hasHomeNavigation =
            bodyText.includes(
                'tasks'
            ) &&
            bodyText.includes(
                'archive'
            );



        // -----------------------------------------------------
        // SIGNS THAT AN ACTIVE TASK IS OPEN
        // -----------------------------------------------------

        const hasTaskTabs =
            bodyText.includes(
                'diff'
            ) &&
            bodyText.includes(
                'logs'
            );


        const hasTaskReplyComposer =
            bodyText.includes(
                'request changes or ask a question'
            );


        const looksLikeActiveTask =
            hasTaskTabs ||
            hasTaskReplyComposer;



        return (
            hasDescribeTaskComposer &&
            hasHomeNavigation &&
            !looksLikeActiveTask
        );
    }



    // =========================================================
    // HEADER MANAGEMENT
    //
    // HOME:
    //     hidden
    //
    // ACTIVE TASK:
    //     visible
    // =========================================================

    let hiddenHeader = null;



    function restoreHeader() {

        if (
            hiddenHeader &&
            hiddenHeader.isConnected
        ) {

            /*
             * Remove ONLY the property this script added.
             */

            hiddenHeader.style
                .removeProperty(
                    'display'
                );
        }


        hiddenHeader = null;
    }



    function findTopHeader() {

        /*
         * Coordinates inside the ordinary ChatGPT
         * top-left header.
         */
        const samplePoints = [
            [25, 25],
            [60, 25],
            [120, 25]
        ];


        for (
            const [x, y]
            of samplePoints
        ) {

            let el =
                document.elementFromPoint(
                    x,
                    y
                );


            while (
                el &&
                el !== document.body &&
                el !== document.documentElement
            ) {

                const rect =
                    el.getBoundingClientRect();


                const startsAtTop =
                    rect.top >= -5 &&
                    rect.top <= 8;


                const headerSized =
                    rect.height >= 35 &&
                    rect.height <= 90;


                const spansScreen =
                    rect.width >=
                    window.innerWidth *
                    0.90;


                if (
                    startsAtTop &&
                    headerSized &&
                    spansScreen
                ) {

                    return el;
                }


                el =
                    el.parentElement;
            }
        }


        return null;
    }



    function manageHeader() {

        /*
         * SAFETY RULE:
         *
         * Unless this is definitely the Codex HOME page,
         * make sure the full header is restored.
         */

        if (
            !isCodexHomeScreen()
        ) {

            restoreHeader();

            return;
        }



        /*
         * Already hidden.
         *
         * Do not search underneath it and accidentally
         * identify some other top-screen element.
         */

        if (
            hiddenHeader &&
            hiddenHeader.isConnected
        ) {

            return;
        }


        hiddenHeader = null;



        const header =
            findTopHeader();


        if (!header) {
            return;
        }


        hiddenHeader =
            header;


        header.style.setProperty(
            'display',
            'none',
            'important'
        );
    }



    // =========================================================
    // APPLY ALL CUSTOMIZATIONS
    // =========================================================

    function applyTweaks() {

        /*
         * 1. Ensure blackout CSS exists.
         */
        installBlackoutCSS();


        /*
         * 2. Hide/restore header depending on page.
         */
        manageHeader();


        /*
         * 3. Widen and reposition home workspace.
         */
        adjustWorkspace();


        /*
         * 4. Black out:
         *
         *    "What should we code next?"
         */
        blackoutTargetText();
    }



    // =========================================================
    // INITIAL LOAD
    //
    // Codex renders in stages.
    // =========================================================

    setTimeout(
        applyTweaks,
        100
    );


    setTimeout(
        applyTweaks,
        500
    );


    setTimeout(
        applyTweaks,
        1000
    );


    setTimeout(
        applyTweaks,
        2000
    );



    // =========================================================
    // REACT / CODEX REDRAWS
    //
    // One observer handles:
    //
    // - home/task navigation
    // - header restore/hide
    // - width changes
    // - blackout text appearing dynamically
    // =========================================================

    let updateTimer;


    const observer =
        new MutationObserver(() => {

            clearTimeout(
                updateTimer
            );


            updateTimer =
                setTimeout(
                    applyTweaks,
                    120
                );
        });



    observer.observe(
        document.body,
        {
            childList: true,
            subtree: true,
            characterData: true
        }
    );



    // =========================================================
    // BROWSER RESIZE
    // =========================================================

    window.addEventListener(
        'resize',
        () => {

            clearTimeout(
                updateTimer
            );


            updateTimer =
                setTimeout(
                    applyTweaks,
                    150
                );
        }
    );

})();

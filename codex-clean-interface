// ==UserScript==
// @name         Codex - Compact Wider Interface
// @namespace    codex-interface-tweaks
// @version      5.0
// @description  Hides the ChatGPT header, widens Codex, and removes excess space above the task composer
// @match        https://chatgpt.com/*
// @match        https://*.chatgpt.com/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    'use strict';


    // =========================================================
    // SETTINGS
    // =========================================================

    /*
     * CODEX WIDTH
     *
     * 1.20 = 20% wider
     * 1.30 = 30% wider
     * 1.40 = 40% wider
     *
     * Diagnostic showed the normal Codex width is about 768px.
     */
    const WIDTH_MULTIPLIER = 1.70;


    /*
     * MOVE CODEX UP
     *
     * Reduces the large blank black area above "Describe a task".
     *
     * 50  = small reduction
     * 75  = moderate
     * 90  = substantial
     * 110 = more aggressive
     * 130 = very compact
     */
    const TOP_SHIFT_PX = 90;


    /*
     * Safety limit so Codex never becomes wider than this
     * percentage of your browser window.
     */
    const MAX_VIEWPORT_WIDTH = 0.92;



    // =========================================================
    // FIND THE CODEX TEXT ENTRY FIELD
    // =========================================================

    function findComposer() {

        const candidates = document.querySelectorAll(
            'textarea, input, [contenteditable="true"], [role="textbox"]'
        );

        for (const el of candidates) {

            const text = [
                el.getAttribute('placeholder'),
                el.getAttribute('aria-label'),
                el.textContent
            ]
                .filter(Boolean)
                .join(' ')
                .toLowerCase();


            if (
                text.includes('describe a task') ||
                text.includes('ask a question') ||
                text.includes('/plan')
            ) {
                return el;
            }
        }

        return null;
    }



    // =========================================================
    // FIND THE MAIN CODEX WORKSPACE
    //
    // Our diagnostic identified this as:
    //
    // div.z-0.mx-auto
    //
    // normally about 768px wide.
    // =========================================================

    function findWorkspace() {

        const composer = findComposer();

        if (!composer) {
            return null;
        }


        let el = composer;


        while (
            el &&
            el !== document.body &&
            el !== document.documentElement
        ) {

            if (
                el.classList &&
                el.classList.contains('z-0') &&
                el.classList.contains('mx-auto')
            ) {
                return el;
            }


            el = el.parentElement;
        }


        return null;
    }



    // =========================================================
    // WIDEN + MOVE CODEX UP
    // =========================================================

    function adjustWorkspace() {

        const workspace = findWorkspace();

        if (!workspace) {
            return;
        }


        // -----------------------------------------------------
        // Remember original width exactly once.
        // -----------------------------------------------------

        if (!workspace.dataset.codexOriginalWidth) {

            const originalWidth =
                workspace.getBoundingClientRect().width;


            workspace.dataset.codexOriginalWidth =
                String(originalWidth);
        }


        const originalWidth =
            parseFloat(
                workspace.dataset.codexOriginalWidth
            );


        if (!originalWidth || isNaN(originalWidth)) {
            return;
        }



        // -----------------------------------------------------
        // Calculate new width
        // -----------------------------------------------------

        const requestedWidth =
            originalWidth * WIDTH_MULTIPLIER;


        const maximumWidth =
            window.innerWidth * MAX_VIEWPORT_WIDTH;


        const finalWidth =
            Math.min(
                requestedWidth,
                maximumWidth
            );



        // -----------------------------------------------------
        // Apply width
        // -----------------------------------------------------

        workspace.style.setProperty(
            'width',
            `${finalWidth}px`,
            'important'
        );


        workspace.style.setProperty(
            'max-width',
            `${finalWidth}px`,
            'important'
        );


        workspace.style.setProperty(
            'min-width',
            '0',
            'important'
        );


        workspace.style.setProperty(
            'margin-left',
            'auto',
            'important'
        );


        workspace.style.setProperty(
            'margin-right',
            'auto',
            'important'
        );



        // -----------------------------------------------------
        // REDUCE BLANK AREA ABOVE CODEX
        // -----------------------------------------------------

        workspace.style.setProperty(
            'transform',
            `translateY(-${TOP_SHIFT_PX}px)`,
            'important'
        );



        // -----------------------------------------------------
        // Remove old inner 768px width restrictions.
        //
        // Some descendants inherit the original Codex width,
        // so allow those to fill our newly widened workspace.
        // -----------------------------------------------------

        const descendants =
            workspace.querySelectorAll(
                'div, section, form'
            );


        descendants.forEach(el => {

            const rect =
                el.getBoundingClientRect();


            if (
                rect.width >= originalWidth - 5 &&
                rect.width <= originalWidth + 5
            ) {

                el.style.setProperty(
                    'max-width',
                    '100%',
                    'important'
                );


                el.style.setProperty(
                    'width',
                    '100%',
                    'important'
                );
            }
        });
    }



    // =========================================================
    // HIDE THE CHATGPT TOP HEADER
    //
    // This uses the geometry-based method that worked.
    //
    // Rather than relying on ChatGPT's changing class names,
    // we inspect elements physically underneath the top-left
    // portion of the browser.
    // =========================================================

    function hideHeader() {

        /*
         * These points are physically inside the ChatGPT
         * logo/header area.
         */
        const samplePoints = [
            [25, 25],
            [60, 25],
            [120, 25]
        ];


        for (const [x, y] of samplePoints) {

            let el =
                document.elementFromPoint(x, y);


            /*
             * Start with whatever is underneath that pixel and
             * climb its parent hierarchy until we find the actual
             * full-width header.
             */
            while (
                el &&
                el !== document.body &&
                el !== document.documentElement
            ) {

                const rect =
                    el.getBoundingClientRect();


                const startsAtTop =
                    rect.top >= -5 &&
                    rect.top <= 8;


                const headerSized =
                    rect.height >= 35 &&
                    rect.height <= 90;


                const spansScreen =
                    rect.width >=
                    window.innerWidth * 0.90;


                if (
                    startsAtTop &&
                    headerSized &&
                    spansScreen
                ) {

                    el.style.setProperty(
                        'display',
                        'none',
                        'important'
                    );


                    return;
                }


                el =
                    el.parentElement;
            }
        }
    }



    // =========================================================
    // APPLY EVERYTHING
    // =========================================================

    function applyTweaks() {

        hideHeader();

        adjustWorkspace();
    }



    // =========================================================
    // INITIAL PAGE LOAD
    //
    // Codex loads in stages, so run a few times.
    // =========================================================

    setTimeout(
        applyTweaks,
        100
    );


    setTimeout(
        applyTweaks,
        500
    );


    setTimeout(
        applyTweaks,
        1000
    );


    setTimeout(
        applyTweaks,
        2000
    );



    // =========================================================
    // WATCH FOR CODEX / REACT REDRAWS
    // =========================================================

    let updateTimer;


    const observer =
        new MutationObserver(() => {

            clearTimeout(
                updateTimer
            );


            updateTimer =
                setTimeout(
                    applyTweaks,
                    120
                );
        });


    observer.observe(
        document.body,
        {
            childList: true,
            subtree: true
        }
    );



    // =========================================================
    // HANDLE BROWSER RESIZING
    // =========================================================

    window.addEventListener(
        'resize',
        () => {

            clearTimeout(
                updateTimer
            );


            updateTimer =
                setTimeout(
                    applyTweaks,
                    150
                );
        }
    );

})();
